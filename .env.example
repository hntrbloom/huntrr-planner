# Server runtime (never prefix private keys with VITE_)
PORT=3000
NODE_ENV=production
# Optional AI job-description extraction; both values are required.
GEMINI_API_KEY=
GEMINI_MODEL=
# Public project ID used for server-side Firebase ID token verification.
# Set this only if overriding the bundled Firebase project.
FIREBASE_PROJECT_ID=

# Browser build configuration. All VITE_ values are public.
# The existing Firebase config and named database remain the default.
# If changing projects, set the complete matching configuration and database ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# Optional Google Drive Picker / Sheets integration.
# Use a Web OAuth client with the deployed origin registered in Google Cloud.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
VITE_GOOGLE_CLIENT_ID=

# Optional existing Supabase project for read-only export from a legacy session.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
