{
  "name": "huntrr-organizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server.dev.ts",
    "build": "vite build --outDir dist/public && esbuild server.main.ts --bundle --platform=node --format=cjs --external:vite --external:express --external:@google/genai --external:dotenv/config --sourcemap --outfile=dist/server.cjs && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --external:express --external:@google/genai --external:dotenv/config --outfile=dist/app.cjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/server.cjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --experimental-test-module-mocks --test tests/*.test.ts",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:supabase": "node --env-file-if-exists=.env.local scripts/verify-supabase.mjs",
    "verify:vercel": "esbuild api/index.ts --platform=node --format=esm --packages=external --outfile=work/vercel-entry.mjs && node --no-experimental-require-module scripts/verify-vercel-entry.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.4.0",
    "@react-oauth/google": "^0.13.5",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/file-saver": "^2.0.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.0",
    "recharts": "^3.10.0",
    "three": "^0.185.1",
    "uuid": "^14.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@electric-sql/pglite": "^0.5.15",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "acorn": "^8.18.0",
    "acorn-jsx": "^5.3.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.7",
    "puppeteer": "^25.11.0",
    "tailwindcss": "^4.1.14",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": "24.x"
  }
}
